# Copie para .env e ajuste. Nunca commite o .env.

# PostgreSQL (dono: ingestão/DDL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=troque-esta-senha

# Papel somente leitura usado pela API
DB_RO_USER=aurora_ro
DB_RO_PASSWORD=troque-esta-senha-ro

# LLM (Fase 4). Sem chave, a API opera em modo degradado (roteamento por regras).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONFIDENCE_THRESHOLD=0.6

# Caminhos dentro do contêiner
DATA_DIR=/app/data
LOG_DIR=/app/logs

# Porta publicada no host (altere se a 8000 estiver ocupada)
APP_PORT=8000
